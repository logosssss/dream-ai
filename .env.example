# Dream-AI 环境变量清单（可选）
# Spring Boot 默认不会自动加载本文件；若用 IDE / 脚本注入环境变量，可复制为 .env 后填写。
# 更省事的方式：直接改 dream-ai-app/application-local.yml（已 gitignore，启动会 optional 加载）。
# 警告：不要把真实 Key 写进本 example 文件（会被提交）。

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=dream_ai_lab
MYSQL_USER=root
MYSQL_PASSWORD=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Nacos ---
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=dream-ai
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_GROUP=dream
NACOS_CONFIG_GROUP=dream

# --- Postgres / pgvector ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- 通义 DashScope（跑模型必填）---
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_MODEL=qwen3.8-27b
AI_DASHSCOPE_MULTI_MODEL=true
AI_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
AI_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
AI_DASHSCOPE_EMBEDDING_DIM=1024

# --- MCP Client → 智谱（可选）---
DREAM_MCP_CLIENT_ENABLED=false
# sync = SyncMcpToolCallback；async = AsyncMcpToolCallback
DREAM_MCP_CLIENT_MODE=sync
ZHIPU_API_KEY=
